<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraphPlugin.Application\GraphPlugin.Application.csproj" />
    <ProjectReference Include="..\GraphPlugin.Domain\GraphPlugin.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="hostdbmgd">
      <HintPath>$(NanoCadInstallDir)\bin\hostdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="hostmgd">
      <HintPath>$(NanoCadInstallDir)\bin\hostmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="StageManagedPlugin" AfterTargets="Build">
    <PropertyGroup>
      <PluginStageDir>$(MSBuildThisFileDirectory)..\..\artifacts\plugin\$(Configuration)\</PluginStageDir>
    </PropertyGroup>

    <ItemGroup>
      <PluginStageFiles Include="$(TargetDir)GraphPlugin.Domain.dll" />
      <PluginStageFiles Include="$(TargetDir)GraphPlugin.Application.dll" />
      <PluginStageFiles Include="$(TargetPath)" />
    </ItemGroup>

    <MakeDir Directories="$(PluginStageDir)" />
    <Copy
      SourceFiles="@(PluginStageFiles)"
      DestinationFolder="$(PluginStageDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
